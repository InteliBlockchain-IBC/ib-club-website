  "license": "MIT",
  "bugs": {
    "url": "https://github.com/InteliBlockchain-IBC/ib-club-website/issues"
  },
  "homepage": "https://github.com/InteliBlockchain-IBC/ib-club-website#readme",
  "description": "The official website of the Inteli Blockchain Club.",
  "dependencies": {
    "express": "^4.21.2",
    "parcel-bundler": "^1.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.140.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
